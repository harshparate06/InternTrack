
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-0 py-3">

    <!-- Welcome Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge rounded-pill px-3 py-2 mb-2"
                  style="background: #ede9fe; color: #5b21b6;">
                YOUR CAREER WORKSPACE
            </span>

            <h1 class="fw-bold mb-2" style="color: #1e1b4b;">
                Welcome to InternTrack 👋
            </h1>

            <p class="text-secondary mb-0">
                Keep your internship journey organized, one opportunity at a time.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-lg text-white rounded-3 px-4 shadow-sm"
           style="background: #6d28d9;">
            + Add Internship
        </a>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 rounded-4 shadow-sm"
                 style="border-top: 4px solid #6d28d9 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary fw-semibold">Total Applications</span>
                        <span class="rounded-3 p-2"
                              style="background: #ede9fe;">📁</span>
                    </div>
                    <h2 class="fw-bold mb-2" style="color: #5b21b6;">
                        @ViewBag.TotalApplications
                    </h2>
                    <p class="text-secondary small mb-0">
                        All tracked opportunities
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 rounded-4 shadow-sm"
                 style="border-top: 4px solid #0284c7 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary fw-semibold">Applied</span>
                        <span class="rounded-3 p-2"
                              style="background: #e0f2fe;">📨</span>
                    </div>
                    <h2 class="fw-bold text-info mb-2">
                        @ViewBag.AppliedCount
                    </h2>
                    <p class="text-secondary small mb-0">
                        Applications submitted
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 rounded-4 shadow-sm"
                 style="border-top: 4px solid #d97706 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary fw-semibold">Interviews</span>
                        <span class="rounded-3 p-2"
                              style="background: #fef3c7;">🎯</span>
                    </div>
                    <h2 class="fw-bold mb-2" style="color: #d97706;">
                        @ViewBag.InterviewCount
                    </h2>
                    <p class="text-secondary small mb-0">
                        Interview opportunities
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 rounded-4 shadow-sm"
                 style="border-top: 4px solid #059669 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary fw-semibold">Selected</span>
                        <span class="rounded-3 p-2"
                              style="background: #d1fae5;">🏆</span>
                    </div>
                    <h2 class="fw-bold text-success mb-2">
                        @ViewBag.SelectedCount
                    </h2>
                    <p class="text-secondary small mb-0">
                        Successful applications
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-2" style="color: #1e1b4b;">
                Quick Actions
            </h5>
            <p class="text-secondary mb-4">
                Pick up where you left off.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a asp-action="Index"
                   class="btn text-white rounded-3 px-4 py-2"
                   style="background: #6d28d9;">
                    View My Applications →
                </a>

                <a asp-action="Create"
                   class="btn btn-outline-secondary rounded-3 px-4 py-2">
                    + Track a New Internship
                </a>
            </div>
        </div>
    </div>

    <p class="text-center text-secondary small mt-4 mb-0">
        Every application is a step toward your next opportunity. ✨
    </p>

</div>
