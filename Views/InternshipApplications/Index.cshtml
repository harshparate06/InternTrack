
@model List<InternTrack.Models.InternshipApplication>

@{
    ViewData["Title"] = "My Internship Applications";
}

<div class="container mt-4">
    <h2>My Internship Applications</h2>
    <p class="text-muted">
        Track all your internship applications in one place.
    </p>

    
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Add Internship
    </a>
</div>


    <div class="card shadow-sm mt-4">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <h5>No applications yet!</h5>
                <p>Start tracking your internship journey here.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Job Role</th>
                                <th>Application Date</th>
                                <th>Status</th>
                                <th>Location</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CompanyName</td>
                                    <td>@item.JobRole</td>
                                    <td>@item.ApplicationDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge bg-primary">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.Location</td>
                                    
                                    <td>
                                        <a asp-action="Edit"
                                        asp-route-id="@item.ApplicationId"
                                        class="btn btn-sm btn-warning">
                                            Edit
                                        </a>
                                   
                                    <form asp-action="Delete"
                                        asp-route-id="@item.ApplicationId"
                                        method="post"
                                        style="display:inline"
                                        onsubmit="return confirm('Are you sure you want to delete this application?');">

                                        <button type="submit" class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
