
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InternTrack</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InternTrack.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm mb-4"
             style="background: linear-gradient(90deg, #312e81, #6d28d9);">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="InternshipApplications"
                   asp-action="Dashboard">
                    <span class="me-2">✦</span> InternTrack
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="InternshipApplications"
                               asp-action="Dashboard">
                                🏠 Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="InternshipApplications"
                               asp-action="Index">
                                📋 My Applications
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-light text-dark fw-semibold px-3 ms-lg-2"
                               asp-controller="InternshipApplications"
                               asp-action="Create">
                                + Add Internship
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 py-3 border-top">
        <div class="container text-center text-muted small">
            © 2026 InternTrack · Manage your career journey
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
